# Copy to web/.env and adjust. Never commit real credentials.
#
# web/.env is the complete configuration for the web app. It is independent of
# the Python app's python/.env — there is no cross-app fallback.

# Which database backend the server uses:
#   local       -> a local SQLite file (development, tests) at ERP_LOCAL_DB
#   sqlitecloud -> the hosted SQLite Cloud database (slow; legacy)
# Production runs local: the local file is the source of truth and SQLite
# Cloud is kept as a read-only replica (see ERP_REPLICA_MINUTES below).
ERP_DB_ENGINE=local

# Path to the local SQLite file used when ERP_DB_ENGINE=local
ERP_LOCAL_DB=./data/dev.sqlite

# Connection string for the hosted SQLite Cloud database. In local-primary
# mode this is the REPLICA the server pushes to — nothing is ever read from
# it, so never edit it in the SQLite Cloud dashboard (the next push
# overwrites it). Leave empty to run with no cloud copy.
# Format: sqlitecloud://user:password@host:port/database
SQLITE_CLOUD_URL=

# Scratch database used by `npm run dev:testdb` (safe to write to).
SQLITE_CLOUD_TESTDB_URL=

# --- Cloud replica (local-primary mode) -------------------------------------
# The local database is pushed to SQLITE_CLOUD_URL at startup, at shutdown,
# on demand (Settings → Cloud copy) and every N minutes (default 15). Each
# push replaces the whole cloud database atomically. Set ERP_REPLICA_DRY_RUN=1
# to build the push script and log its size without sending anything.
ERP_REPLICA_MINUTES=15
# ERP_REPLICA_DRY_RUN=1
# Where pushes stage their temporary snapshot.
# ERP_REPLICA_DIR=./backups/replica

# --- HTTP server ------------------------------------------------------------
# Bind address. 0.0.0.0 exposes the API on the network; 127.0.0.1 is for a
# reverse proxy in front of it.
ERP_HOST=0.0.0.0
PORT=4000

# --- Production single-process mode (Windows service) ------------------------
# Serve the built React client from this same process (one port, one service).
# Requires `npm run build` first. Leave 0 in development: Vite serves the client.
ERP_SERVE_CLIENT=0

# Where the built client lives (relative to web/).
# ERP_CLIENT_DIST=./client/dist

# Optional HTTPS: set BOTH to have this process terminate TLS itself.
# ERP_TLS_CERT=./certs/erp.crt
# ERP_TLS_KEY=./certs/erp.key

# --- Backups and the live local copy ---------------------------------------
# Folder for snapshots, named by bare UTC timestamp (<YYYYMMDD_HHMMSS>.db).
# ERP_BACKUP_DIR=./backups
# Named snapshots to keep (newest first). 0 keeps everything.
# ERP_BACKUP_KEEP=7
# Every snapshot is also copied to this folder (default: the user's Desktop);
# for an off-machine copy point it at a mapped/shared folder, e.g.
# ERP_DESKTOP_DIR=\\your-pc\bop-backup
# ERP_DESKTOP_DIR=./backups/app-copy
# Optional extra folder for named snapshots, e.g. a NAS or your PC's shared
# folder: ERP_PC_MIRROR_DIR=\\your-pc\bop-backup (or /mnt/nas/bop).
# Auto-backup interval in hours. 0 disables the scheduler; 1 with
# ERP_BACKUP_KEEP=168 gives one snapshot an hour for a week.
ERP_AUTO_BACKUP_HOURS=1
ERP_BACKUP_KEEP=168
# Live local copy: continuously rewritten after writes. Redundant in
# local-primary mode (the database itself is already local) — leave off.
ERP_LIVE_MIRROR=0
ERP_MIRROR_DEBOUNCE_SECONDS=15
# Push the live copy to your computer (mapped drive or UNC share).
# ERP_PC_MIRROR_DIR=\\your-pc\bop-backup
