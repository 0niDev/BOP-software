# Web app environment. Git-ignored (see .gitignore).
#
# This file is the COMPLETE configuration for the web app. It is never merged
# with the Python app's .env (python/.env) — each app owns its own file.

# Database backend:
#   sqlitecloud -> the hosted SQLite Cloud database (SQLITE_CLOUD_URL below)
#   local       -> a local SQLite file at ERP_LOCAL_DB (offline development)
ERP_DB_ENGINE=local

# Local SQLite file — switch ERP_DB_ENGINE to `local` to develop offline.
ERP_LOCAL_DB=./data/erp.sqlite

# HTTP server (the Vite client proxies /api here in dev)
PORT=4000

# Hosted SQLite Cloud connection string (copied from the old shared root .env
# when the apps were separated). Format:
#   sqlitecloud://user:password@host:port/database
# Hosted `maindb.db` database — this is the production source of truth.
SQLITE_CLOUD_URL=sqlitecloud://cjja8z6pvz.g4.sqlite.cloud:8860/mainDB?apikey=bmJZ0l1RTFCoxS0Au17c0iofzZmrDn2Db94v0YtV9Uw

# Scratch database — `npm run dev:testdb` runs the app against this one instead.
SQLITE_CLOUD_TESTDB_URL=sqlitecloud://cjja8z6pvz.g4.sqlite.cloud:8860/testdb?apikey=bmJZ0l1RTFCoxS0Au17c0iofzZmrDn2Db94v0YtV9Uw

# Push the continuously-refreshed live copy to a folder on the desktop,
# next to the named-snapshot copies the server puts there.
ERP_PC_MIRROR_DIR=/home/oni/Desktop/desktop

# Auto-backup every 30 minutes the server is running; keep the newest 1000.
ERP_AUTO_BACKUP_HOURS=0.5
ERP_BACKUP_KEEP=1000

# --- rehearsal of local-primary mode (see DEPLOYMENT.md) -------------------
# Fast cadence for testing; set back to 5 after the rehearsal.
ERP_REPLICA_MINUTES=5
ERP_LIVE_MIRROR=0

# Production: serve built React client from same process (one port)
ERP_SERVE_CLIENT=1
ERP_HOST=0.0.0.0
