{
  "name": "@bop-erp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP API + business logic for the BOP Nutraceuticals ERP",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed.ts",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@sqlitecloud/drivers": "^1.0.982",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
