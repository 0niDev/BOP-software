# .env – secret values for production cloud deployment
# ----------------------------------------------------
# Cloud SQLite connection (replace with your actual connection string)
SQLITE_CLOUD_URL=https://api.sqlitecloud.com/v2/instance/your-instance-id

# API key used by internal services that call external endpoints
ERP_API_KEY=super_secret_api_key_12345

# Optional: backup related config
ERP_BACKUP_DIR=backups
ERP_AUTO_BACKUP_HOURS=0   # disabled by default; enable via env var if needed