# Python / PySide6 app environment. Copy to python/.env and fill in.
# Never commit real credentials.
#
# python/.env is the COMPLETE configuration for the Python app. It is separate
# from web/.env — the two applications do not share or fall back to each
# other's environment files.

# Database backend:
#   sqlitecloud -> the hosted SQLite Cloud database (SQLITE_CLOUD_URL below)
#   sqlite      -> a local SQLite file
ERP_DB_ENGINE=sqlitecloud

# Hosted SQLite Cloud connection string.
# Format: sqlitecloud://user:password@host:port/database
SQLITE_CLOUD_URL=

# Logging: DEBUG / INFO / WARNING / ERROR / CRITICAL
# ERP_LOG_LEVEL=INFO

# --- Only needed when ERP_DB_ENGINE is mysql/postgresql ------------------------
# ERP_DB_HOST=localhost
# ERP_DB_PORT=5432
# ERP_DB_NAME=pharma_erp
# ERP_DB_USER=
# ERP_DB_PASSWORD=
