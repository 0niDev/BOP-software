{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail",
    "@sentropic/engram",
    "opencode-command-hooks",
    "opencode-mem",
    "opencode-models-discovery",
    "@morphllm/opencode-morph-plugin"
  ],
  "instructions": [
    "node_modules/@morphllm/opencode-morph-plugin/instructions/morph-tools.md"
  ],
  "permissions": [
    { "action": "shell", "resource": "*maindb*", "effect": "deny" },
    { "action": "shell", "resource": "*SQLITE_CLOUD_URL*", "effect": "deny" },
    { "action": "shell", "resource": "*pull-cloud*", "effect": "deny" },
    { "action": "shell", "resource": "npm run dev *", "effect": "deny" },
    { "action": "shell", "resource": "npm run dev:server *", "effect": "deny" },
    { "action": "shell", "resource": "npm -w @bop-erp/server run dev *", "effect": "deny" },
    { "action": "shell", "resource": "npm --workspace @bop-erp/server run dev *", "effect": "deny" },
    { "action": "shell", "resource": "npm run seed *", "effect": "deny" },
    { "action": "shell", "resource": "npm run seed:rich *", "effect": "deny" },
    { "action": "shell", "resource": "node dist/index.js *", "effect": "deny" },
    { "action": "shell", "resource": "npm run dev:testdb *", "effect": "allow" }
  ],
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM-5.3 Flash"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "model": "openrouter/auto"
    }
  }
}
