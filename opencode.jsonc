{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail",
    "@sentropic/engram",
    "opencode-command-hooks",
    "opencode-mem",
    "opencode-models-discovery",
    "@morphllm/opencode-morph-plugin"
